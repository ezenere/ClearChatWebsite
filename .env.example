# ClearChat — servidor de sync (copie para .env e preencha). Ver docs/ARCHITECTURE.md.
# Segredos: gere com `openssl rand -base64 48` — ou `make -C backend init-env`, que cria o .env com
# SERVER_SECRET, ADMIN_TOKEN e POSTGRES_PASSWORD preenchidos. NUNCA commite o .env.

# ---------- instância ----------
# URL pública da instância: esquema://host[:porta][/caminho], sem "/" final.
# Define <base> (SYNC_PROTOCOL.md): links dos e-mails, /api/info, hostname do Turnstile, base path das rotas.
PUBLIC_BASE_URL=https://clear.ezenere.com
# Origens extras liberadas no CORS (separadas por vírgula). Vazio = sem CORS (site na mesma origem).
ALLOWED_ORIGINS=
# Valores INICIAIS das configurações da instância (depois mandam as do painel admin, no banco)
INSTANCE_NAME=ClearChat
INITIAL_SIGNUP_OPEN=true
INITIAL_LANDING_ENABLED=true
DOWNLOAD_URL=https://github.com/ezenere/ClearChat/releases

# ---------- segredos do servidor ----------
# HMAC dos códigos por e-mail, dos e-mails nos contadores e das sessões. Trocar invalida códigos pendentes.
SERVER_SECRET=
# Token do painel admin (≥ 32 caracteres). Vazio = admin não sobe.
ADMIN_TOKEN=

# ---------- banco ----------
POSTGRES_USER=clearchat
POSTGRES_PASSWORD=
POSTGRES_DB=clearchat
# No Docker o compose monta a DATABASE_URL a partir das três variáveis acima (esta linha é ignorada lá).
# Fora do Docker (desenvolvimento): aponte para o seu Postgres, ex. postgresql+asyncpg://clearchat:senha@127.0.0.1:5432/clearchat
DATABASE_URL=postgresql+asyncpg://clearchat:troque@127.0.0.1:5432/clearchat

# ---------- e-mail (SMTP próprio) ----------
# MAIL_BACKEND: auto (smtp se SMTP_HOST estiver preenchido, senão console) | smtp | console
# "console" escreve o e-mail (com o código!) no log — só para desenvolvimento.
MAIL_BACKEND=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="ClearChat <no-reply@ezenere.com>"
# starttls | ssl | none
SMTP_TLS_MODE=starttls
SMTP_VALIDATE_CERTS=true
SMTP_TIMEOUT_S=15

# ---------- captcha (Cloudflare Turnstile, OPCIONAL) ----------
# Vazios = instância sem captcha (features.captcha = null); os limites de taxa continuam.
# Chaves de teste da Cloudflare (sempre passam): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- rede / portas (host) ----------
# Interface onde api e web são publicadas no host. Produção: o Nginx roda na MESMA máquina → 127.0.0.1.
BIND_ADDR=127.0.0.1
API_PORT=8100
WEB_PORT=8101
# Admin: por padrão só 127.0.0.1 (acesso por túnel SSH). Para liberar na rede LOCAL, ponha o IP da LAN
# do servidor em ADMIN_BIND_ADDR e em ADMIN_ALLOWED_HOSTS (o admin recusa outros cabeçalhos Host).
# Nunca exponha à internet nem roteie no Nginx.
ADMIN_PORT=8190
ADMIN_BIND_ADDR=127.0.0.1
ADMIN_ALLOWED_HOSTS=
# Perfil "edge" (self-host sem Nginx próprio): Caddy numa porta só.
EDGE_PORT=8080
# Sub-rede fixa da rede do compose e proxies confiáveis (de onde aceitar X-Real-IP).
# Nginx local → 127.0.0.1:API_PORT chega no container pelo gateway da bridge (172.31.250.1).
# Perfil "edge" (Caddy na rede interna): use a sub-rede inteira (172.31.250.0/24).
COMPOSE_SUBNET=172.31.250.0/24
TRUSTED_PROXY_CIDRS=127.0.0.1/32,172.31.250.1/32

# ---------- armazenamento ----------
BLOB_STORAGE_DIR=/data/blobs

# ---------- tempos e limites (padrões do protocolo; mudar só se souber o que faz) ----------
EMAIL_CODE_TTL_S=600
EMAIL_CODE_MAX_ATTEMPTS=5
INVITE_TTL_DAYS=7
ACCESS_TOKEN_TTL_S=3600
REFRESH_TOKEN_TTL_DAYS=60
HOST_DROP_GRACE_S=10
SERVER_RESTART_GRACE_S=60
HANDOVER_FORCE_TIMEOUT_S=20
COMMAND_RESULT_TIMEOUT_S=30
TOMBSTONE_RETENTION_DAYS=180
PUSH_RECEIPT_TTL_DAYS=7
BLOB_ORPHAN_GRACE_H=24
ACTIVITY_RETENTION_DAYS=90

# Cotas padrão para contas novas (vazio = ilimitado)
DEFAULT_QUOTA_RECORD_BYTES=
DEFAULT_QUOTA_RECORDS=
DEFAULT_QUOTA_BLOB_BYTES=
DEFAULT_QUOTA_DEVICES=

LOG_LEVEL=info
# json (produção) | text
LOG_FORMAT=json
