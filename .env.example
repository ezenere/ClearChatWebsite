# ClearChat — servidor de sync (copie para .env e preencha). Ver docs/ARCHITECTURE.md.
# Segredos: gere com `openssl rand -base64 48` — ou `make -C backend init-env`, que cria o .env com
# SERVER_SECRET, ADMIN_TOKEN e POSTGRES_PASSWORD preenchidos. NUNCA commite o .env.

# ---------- instância ----------
# URL pública da instância: esquema://host[:porta][/caminho], sem "/" final.
# Define <base> (SYNC_PROTOCOL.md): links dos e-mails, /api/info, hostname do Turnstile, base path das rotas.
PUBLIC_BASE_URL=https://clear.ezenere.com
# E-mail de contato mostrado na política de privacidade (/privacidade): pedidos de exclusão e direitos da
# LGPD. Vazio = a página manda falar com o operador da instância.
PRIVACY_CONTACT_EMAIL=suporte@ezenere.com
# Origens extras liberadas no CORS (separadas por vírgula). Vazio = sem CORS (site na mesma origem).
# "*" é recusado na subida (o CORS vai com credenciais): liste as origens exatas.
ALLOWED_ORIGINS=
# Valores INICIAIS das configurações da instância (depois mandam as do painel admin, no banco)
INSTANCE_NAME=ClearChat
INITIAL_SIGNUP_OPEN=true
INITIAL_LANDING_ENABLED=true
DOWNLOAD_URL=https://github.com/ezenere/ClearChatDesktop/releases

# ---------- segredos do servidor ----------
# HMAC dos códigos por e-mail, dos e-mails nos contadores e das sessões. Trocar invalida códigos pendentes.
SERVER_SECRET=
# Token do painel admin (≥ 32 caracteres). Vazio = admin não sobe.
ADMIN_TOKEN=

# ---------- banco ----------
POSTGRES_USER=clearchat
POSTGRES_PASSWORD=
POSTGRES_DB=clearchat
# No Docker o compose monta a DATABASE_URL a partir das três variáveis acima (esta linha é ignorada lá).
# Fora do Docker (desenvolvimento): aponte para o seu Postgres, ex. postgresql+asyncpg://clearchat:senha@127.0.0.1:5432/clearchat
DATABASE_URL=postgresql+asyncpg://clearchat:troque@127.0.0.1:5432/clearchat

# ---------- e-mail (SMTP próprio) ----------
# MAIL_BACKEND: auto (smtp se SMTP_HOST estiver preenchido; senão NENHUM e-mail sai e a subida avisa) | smtp | console
# "console" escreve o e-mail (com o código!) no log — só para desenvolvimento, e só se escolhido aqui.
MAIL_BACKEND=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="ClearChat <no-reply@ezenere.com>"
# starttls | ssl | none
SMTP_TLS_MODE=starttls
SMTP_VALIDATE_CERTS=true
SMTP_TIMEOUT_S=15

# ---------- captcha (Cloudflare Turnstile, OPCIONAL) ----------
# Vazios = instância sem captcha (features.captcha = null); os limites de taxa continuam.
# Chaves de teste da Cloudflare (sempre passam): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- notificações push (Firebase Cloud Messaging, OPCIONAL) ----------
# Avisos no celular (aprovação pendente, resposta pronta, host caiu) — SYNC_PROTOCOL §22. O conteúdo vai
# cifrado de ponta a ponta; o servidor só repassa ao FCM. Vazio = instância sem push (features.push = null).
# Firebase Console → Configurações do projeto → Contas de serviço → "Gerar nova chave privada" (JSON).
# Guarde o JSON FORA do repositório git (ex.: ./secrets/, que está no .gitignore) e deixe legível pelo
# usuário do container (uid 10001): sudo chown 10001 secrets/arquivo.json && sudo chmod 400 secrets/arquivo.json
# No Docker o compose monta PUSH_SECRETS_DIR (padrão ./secrets) em /run/secrets/clearchat (só leitura):
#   FCM_SERVICE_ACCOUNT_FILE=/run/secrets/clearchat/arquivo.json
# Fora do Docker (desenvolvimento): o caminho do arquivo nesta máquina.
FCM_SERVICE_ACCOUNT_FILE=
PUSH_SECRETS_DIR=./secrets
# Aviso "host caiu" (§22.6): só depois de N s offline seguidos e no máximo um por host a cada M s.
HOST_OFFLINE_PUSH_DELAY_S=120
HOST_OFFLINE_PUSH_COOLDOWN_S=1800

# ---------- conta de revisão das lojas (OPCIONAL) ----------
# Para o revisor do Google Play / App Store entrar sem receber e-mail: este e-mail usa sempre o código fixo
# de 6 dígitos no cadastro e no login (nenhum e-mail é enviado; mesmos limites de tentativa). Apagar a conta
# e resetar chaves continuam pedindo código aleatório por e-mail. Vazios = desligado.
# O código vale como senha permanente dessa conta: deixe nela só dados de demonstração.
REVIEW_LOGIN_EMAIL=
REVIEW_LOGIN_CODE=

# ---------- rede / portas (host) ----------
# Interface onde api e web são publicadas no host. Produção: o Nginx roda na MESMA máquina → 127.0.0.1.
BIND_ADDR=127.0.0.1
API_PORT=8100
WEB_PORT=8101
# Admin: por padrão só 127.0.0.1 (acesso por túnel SSH). Para liberar na rede LOCAL, ponha o IP da LAN
# do servidor em ADMIN_BIND_ADDR e em ADMIN_ALLOWED_HOSTS (o admin recusa outros cabeçalhos Host).
# Nunca exponha à internet nem roteie no Nginx.
ADMIN_PORT=8190
ADMIN_BIND_ADDR=127.0.0.1
ADMIN_ALLOWED_HOSTS=
# true quando o painel é servido por https (proxy TLS na frente): cookie de sessão com Secure.
ADMIN_HTTPS=false
# Perfil "edge" (self-host sem Nginx próprio): Caddy numa porta só, com IP fixo na rede interna (EDGE_IP).
EDGE_PORT=8080
EDGE_IP=172.31.250.250
# Sub-rede fixa da rede do compose e proxies confiáveis (de onde aceitar X-Real-IP).
# Nginx local → 127.0.0.1:API_PORT chega no container pelo gateway da bridge (172.31.250.1);
# perfil "edge" → o Caddy chega de EDGE_IP (172.31.250.250). Os dois já estão no padrão abaixo.
# Mudou COMPOSE_SUBNET? Ajuste EDGE_IP e estes endereços juntos. Proxy fora desta lista = todos os
# clientes com o IP do proxy (limites por IP compartilhados por todo mundo).
COMPOSE_SUBNET=172.31.250.0/24
TRUSTED_PROXY_CIDRS=127.0.0.1/32,172.31.250.1/32,172.31.250.250/32

# ---------- armazenamento ----------
BLOB_STORAGE_DIR=/data/blobs
# Na subida, apaga temporários de upload de blob (*.tmp-*) mais velhos que isto, em segundos (sobra de queda).
BLOB_TMP_SWEEP_AGE_S=3600

# ---------- tempos e limites (padrões do protocolo; mudar só se souber o que faz) ----------
EMAIL_CODE_TTL_S=600
EMAIL_CODE_MAX_ATTEMPTS=5
INVITE_TTL_DAYS=7
ACCESS_TOKEN_TTL_S=3600
REFRESH_TOKEN_TTL_DAYS=60
HOST_DROP_GRACE_S=10
SERVER_RESTART_GRACE_S=60
HANDOVER_FORCE_TIMEOUT_S=20
COMMAND_RESULT_TIMEOUT_S=30
TOMBSTONE_RETENTION_DAYS=180
PUSH_RECEIPT_TTL_DAYS=7
BLOB_ORPHAN_GRACE_H=24
ACTIVITY_RETENTION_DAYS=90
# Teto do ciphertext de UM registro no push (acima → 413 payload_too_large). 16 MiB; anexos vão em blobs.
RECORD_MAX_BYTES=16777216
# Teto de estados de chat (chat_states) por usuário criados por host.begin/takeover/pin
# (acima → 413 quota_exceeded, kind "chat_states"). 0 = sem teto.
MAX_CHAT_STATES_PER_USER=20000
# GC: estado de chat sem registro do chat, sem host/janela/troca e parado há mais que isto (horas) é apagado.
CHAT_STATE_ORPHAN_GRACE_H=24
# A cada N s confere as conexões WebSocket vivas contra o banco (revogação/ban perdidos com o LISTEN fora).
WS_RECONCILE_INTERVAL_S=60

# Cotas padrão para contas novas (vazio = ilimitado)
DEFAULT_QUOTA_RECORD_BYTES=
DEFAULT_QUOTA_RECORDS=
DEFAULT_QUOTA_BLOB_BYTES=
DEFAULT_QUOTA_DEVICES=

LOG_LEVEL=info
# json (produção) | text
LOG_FORMAT=json
